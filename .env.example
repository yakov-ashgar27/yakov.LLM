# Copy to .env (or set in your host's dashboard). Set ONE model key for written answers:
GROQ_API_KEY=              # free, no credit card: console.groq.com
# GEMINI_API_KEY=          # free tier: aistudio.google.com
# ANTHROPIC_API_KEY=       # Claude (paid)
# LLM_MODEL=               # override the provider's default model
GITHUB_USER=yakov-ashgar27
# GITHUB_TOKEN=            # optional: higher GitHub API rate limit
# SYNC_INTERVAL_MIN=30     # how often to check GitHub for new or changed projects (0 = off)
# WEBHOOK_SECRET=          # set the same secret on a GitHub webhook for instant updates
# SYNC_TOKEN=              # protects POST /api/sync
# RATE_LIMIT=30            # chat requests per IP per 10 minutes
# ADMIN_TOKEN=             # password for /admin.html (who talked with yakov.LLM and their unverified notes)
# MEMORY_REPO=             # private repo "owner/name" that keeps the memory across deploys
# MEMORY_TOKEN=            # fine-grained token: Contents read & write on MEMORY_REPO only
